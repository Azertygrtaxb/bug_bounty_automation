# SURCHARGE LOCALE TEMPORAIRE — non suivie par git.
# Fige places ET concurrence a 8 (un ecart entre les deux = tempete de refus).
# A supprimer quand tu voudras piloter depuis .env (qui dit 24/24).
services:
  worker:
    environment:
      RL_GLOBAL_MAX_HOSTS: "8"
      CELERY_CONCURRENCY: "8"

# >>> bb-ops
