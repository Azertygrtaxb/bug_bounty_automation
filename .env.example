# Copier vers .env puis ajuster. Aucune de ces valeurs n'est en dur dans le code.

# --- Postgres (lues par le service postgres et par la substitution compose) ---
POSTGRES_USER=bbhunter
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=bugbounty

# --- URLs côté hôte, utilisées par engine/enqueue.py lancé depuis ta machine ---
# (dans les conteneurs, docker-compose fournit les URLs internes redis:// et postgres://)
CELERY_BROKER_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://bbhunter:change_me_local_dev@localhost:5432/bugbounty

# --- Rotation d'IP (IVPN machine-wide OU proxy-URL) ---
# IVPN : identifiant de compte (placeholder ; la VRAIE valeur va dans .env, gitignoré)
IVPN_ACCOUNT_ID=i-XXXX-XXXX-XXXX
# Commande de rotation appelée par le pipeline quand le WAF réagit (host-side)
RECON_ROTATE_CMD=/usr/local/bin/rotate-egress.sh
# URL NEUTRE pour vérifier l'IP de sortie (jamais une cible)
ROTATION_TEST_URL=https://api.ipify.org
# Nb d'événements débit (429/challenge/403-escalade/p95x2) dans la fenêtre avant rotation
SEUIL_ROTATION=3
# Alternative proxy-URL (laisser vide si IVPN machine-wide)
# RECON_PROXY=http://mon-proxy-rotatif:8080
